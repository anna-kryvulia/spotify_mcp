# Скопіюй у .env і заповни. .env не комітити!

# Spotify Developer Dashboard → твій застосунок → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Має точно збігатися з Redirect URI у Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Безкоштовна модель з підтримкою tools. Список змінюється — перевір: python check_openrouter.py
OPENROUTER_MODEL=openai/gpt-oss-120b:free
